# Copy this file to .env and fill it in. NEVER commit .env.

# PayPal SANDBOX app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# LLM for the pricing assistant. FREE option: Groq (console.groq.com, no credit card).
# If no key is set, the app falls back to a clearly labeled template mode.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional paid alternative:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Used only if the live rate API is unreachable. Put a recent USD->INR mid-market rate here.
# It is shown to the user as a "snapshot", never as live.
FALLBACK_USD_INR=

# Only if your frontend runs on a different address, e.g. http://localhost:5173
ALLOWED_ORIGIN=

PORT=3000
